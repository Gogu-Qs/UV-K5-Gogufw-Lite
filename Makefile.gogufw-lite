# GOGUFW UV-K5 Lite memory-test build profile
# Usage:
#   make -f Makefile.gogufw-lite clean
#   make -f Makefile.gogufw-lite
#
# This profile disables non-essential features to measure remaining FLASH/RAM
# before attempting a Messenger / Range Check port.

VERSION_STRING=1.0.1

ENABLE_AIRCOPY=0
ENABLE_UART=1
ENABLE_UART_CHIRP_LITE=1
ENABLE_FMRADIO=1
ENABLE_NOAA=0
ENABLE_VOICE=0
ENABLE_VOX=0
ENABLE_ALARM=0
ENABLE_DTMF_CALLING=0
ENABLE_SPECTRUM=0

# Also keep these disabled unless explicitly needed.
ENABLE_TX1750=0
ENABLE_PWRON_PASSWORD=0
ENABLE_BOOT_BEEPS=0
ENABLE_SHOW_CHARGE_LEVEL=0
ENABLE_REVERSE_BAT_SYMBOL=0
ENABLE_AM_FIX_SHOW_DATA=0
ENABLE_AGC_SHOW_DATA=0
ENABLE_UART_RW_BK_REGS=0

include Makefile
